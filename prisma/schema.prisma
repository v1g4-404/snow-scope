// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int        @id @default(autoincrement())
  supabaseUserId String     @unique @map("supabase_user_id")
  name           String
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  reviews        Review[]   @relation("ReviewToUser")
  reports        Report[]   @relation("ReportToUser")
  favorites      Favorite[] @relation("FavoriteToUser")
  visits         Visit[]    @relation("VisitToUser")

  @@map("users")
}

enum AreaType {
  PREFECTURE
  REGION
  AREA
}

model Area {
  id        Int       @id @default(autoincrement())
  parentId  Int?      @map("parent_id")
  type      AreaType
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  skiSpots  SkiSpot[]

  parent   Area?  @relation("AreaToArea", fields: [parentId], references: [id])
  children Area[] @relation("AreaToArea")

  @@map("areas")
}

enum WidthType {
  WIDE
  NORMAL
  NARROW
}

model SkiSpot {
  id                Int        @id @default(autoincrement())
  areaId            Int        @map("area_id")
  name              String
  latitude          Float
  longitude         Float
  address           String
  courseCount       Int        @map("course_count")
  maxSlope          Int        @map("max_slope")
  maxDistance       Int        @map("max_distance")
  courseWidth       WidthType  @map("course_width")
  beginnerRatio     Int        @map("beginner_ratio")
  intermediateRatio Int        @map("intermediate_ratio")
  advancedRatio     Int        @map("advanced_ratio")
  ungroomedRatio    Int        @map("ungroomed_ratio")
  groomedRatio      Int        @map("groomed_ratio")
  openTime          String     @map("open_time")
  closeTime         String     @map("close_time")
  liftPrice         Int        @map("lift_price")
  parkingPrice      Int        @map("parking_price")
  hasSchool         Boolean    @map("has_school")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  reviews           Review[]   @relation("ReviewToSkiSpot")
  reports           Report[]   @relation("ReportToSkiSpot")
  favorites         Favorite[] @relation("FavoriteToSkiSpot")
  visits            Visit[]    @relation("VisitToSkiSpot")

  area Area @relation(fields: [areaId], references: [id])

  @@map("ski_spots")
}

model Review {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  skiSpotId Int           @map("ski_spot_id")
  rating    Int
  comment   String
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  level     ReviewLevel[] @relation("ReviewLevelToReview")

  user    User    @relation("ReviewToUser", fields: [userId], references: [id])
  skiSpot SkiSpot @relation("ReviewToSkiSpot", fields: [skiSpotId], references: [id])

  @@map("reviews")
}

model ReviewLevel {
  id       Int @id @default(autoincrement())
  reviewId Int @map("review_id")
  levelId  Int @map("level_id")

  review Review @relation("ReviewLevelToReview", fields: [reviewId], references: [id])
  level  Level  @relation("ReviewLevelToLevel", fields: [levelId], references: [id])

  @@map("review_levels")
}

model Level {
  id        Int           @id @default(autoincrement())
  name      String
  createdAt DateTime      @default(now()) @map("created_at")
  review    ReviewLevel[] @relation("ReviewLevelToLevel")

  @@map("levels")
}

enum QualityType {
  POWDER
  GROOMED
  ICE
  SLUSH
}

enum CongestionType {
  LOW
  NORMAL
  HIGH
}

enum OpenStatusType {
  FULL
  PARTIAL
  CLOSED
}

model Report {
  id          Int            @id @default(autoincrement())
  userId      Int            @map("user_id")
  skiSpotId   Int            @map("ski_spot_id")
  snowQuality QualityType    @map("snow_quality")
  congestion  CongestionType
  snowDepth   Int            @map("snow_depth")
  openStatus  OpenStatusType @map("open_status")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user    User    @relation("ReportToUser", fields: [userId], references: [id])
  skiSpot SkiSpot @relation("ReportToSkiSpot", fields: [skiSpotId], references: [id])

  @@map("reports")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  skiSpotId Int      @map("ski_spot_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation("FavoriteToUser", fields: [userId], references: [id])
  skiSpot SkiSpot @relation("FavoriteToSkiSpot", fields: [skiSpotId], references: [id])

  @@unique([userId, skiSpotId])
  @@map("favorites")
}

model Visit {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  skiSpotId Int      @map("ski_spot_id")
  visitedAt DateTime @map("visited_at")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation("VisitToUser", fields: [userId], references: [id])
  skiSpot SkiSpot @relation("VisitToSkiSpot", fields: [skiSpotId], references: [id])

  @@map("visits")
}
